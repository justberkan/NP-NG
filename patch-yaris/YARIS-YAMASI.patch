+ const tl=RACESTY.lite(0xff3b30);
+ rBox(.34,.12,.06,tl,-o.w*.32,o.y0+o.h*.6,-o.len/2-.02,g);rBox(.34,.12,.06,tl,o.w*.32,o.y0+o.h*.6,-o.len/2-.02,g);
