+}
+
+/* ---------- OTOMOBİLLER ---------- */
+function rmWheels(g,wh,stW,xr,yr,zf,zr,r,wide){
+ const mk=(x,z,steer)=>{
+  const w=new THREE.Group();w.position.set(x,yr,z);
+  const t=new THREE.Mesh(new THREE.CylinderGeometry(r,r,wide,14),RACESTY.dark());
+  t.rotation.z=Math.PI/2;w.add(t);
