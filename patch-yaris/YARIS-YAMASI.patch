+  rmWheels(b.g,wh,stW,.82,.32,1.38,-1.38,.32,.24);
+  return{g:b.g,wh,stW,glw:b.glw,wing};
+ }
+ if(id==='viper'){ // Yılan S — drift
+  const b=rmCarBase({col:0x9b1c31,w:2.0,h:.56,len:4.4,y0:.26,glow:0xff4fd8});
