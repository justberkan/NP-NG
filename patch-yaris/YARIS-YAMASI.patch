+/* ---------- Araç kataloğu ----------
+   glb: assets/race/ altındaki hazır model dosyası. Yüklenemezse prosedürel modele düşer. */
+const RACEGLB={
+ falcon:{f:'sport39.glb',len:4.4},
+ viper:{f:'muscle10.glb',len:4.5},
+ apex:{f:'lamb.glb',len:4.3},
