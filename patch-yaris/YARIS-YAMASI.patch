+'use strict';
+/* ===== Yarış araç modelleri (prosedürel, üçgenlik maliyeti düşük) =====
+   Her yapıcı {g,wh,stW,prop,wing,glw} döndürür:
+   g: grup (yer merkezli, +Z ileri), wh: tekerlek/pervane dizisi, stW: direksiyona dönen ön tekerlekler,
