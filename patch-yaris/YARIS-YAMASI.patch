+/* ---------- AI ---------- */
+RACE.rubber=v=>{ // lastik bandi: oyuncuya gore hafif hiz ayari
+ if(!v.ai)return 1;
+ const pl=RACE.v;if(!pl||pl===v)return 1;
+ const d=(pl.prog-v.prog);
+ return clamp(1+d*.00006,.9,1.1);
+};
+function raceAIThink(v,dt){
+ const tr=RACE.track,inp={th:1,br:0,st:0,drift:false};
+ if(v.air){
+  const ring=RACE.rings[v.nextRing];
+  if(ring){
+   const dx=ring.x-v.x,dy=ring.y-v.y,dz=ring.z-v.z;
+   const ty=Math.atan2(dx,dz),tp=clamp(Math.asin(clamp(dy/(Math.hypot(dx,dz)+1),-1,1)),-.6,.6);
+   let dyaw=ty-v.yaw;while(dyaw>Math.PI)dyaw-=2*Math.PI;while(dyaw<-Math.PI)dyaw+=2*Math.PI;
+   inp.st=clamp(dyaw*2,-1,1);
+   inp.th=clamp((tp-v.pitch)*2.5,-1,1);
+   if(Math.abs(dyaw)<.2&&Math.random()<dt*.15)v.boostT=Math.max(v.boostT,1.2);
+  }
+  v.aiCd=(v.aiCd||0)-dt;
+  if(RACE.cfg.items&&v.aiCd<=0&&v.slots.some(Boolean)){raceAIUse(v);v.aiCd=2.5}
+  return inp;
+ }
+ // kara: yariz cizgisi hedefi
+ const look=26+Math.abs(v.spd)*.5;
+ const i1=(v.ci+Math.floor(look/tr.L*tr.M))%tr.M,q=tr.samples[i1];
+ const tx=q.x+q.rx*v.lat,tz=q.z+q.rz*v.lat;
+ const ty=Math.atan2(tx-v.x,tz-v.z);
+ let dyaw=ty-v.yaw;while(dyaw>Math.PI)dyaw-=2*Math.PI;while(dyaw<-Math.PI)dyaw+=2*Math.PI;
+ inp.st=clamp(dyaw*1.8,-1,1);
+ // onundeki kivrim ne kadar keskin?
+ const i2=(v.ci+Math.floor(45/tr.L*tr.M))%tr.M,q2=tr.samples[i2];
+ const bend=Math.abs(q2.tx*q.tz-q2.tz*q.tx);
+ if(bend>.12&&v.spd>18)inp.br=clamp((bend-.12)*6,0,.8);
+ inp.th=inp.br>.3?.4:1;
+ // duvara yakinsa iceri don
+ const qs=tr.samples[v.ci];
+ const off=(v.x-qs.x)*qs.rx+(v.z-qs.z)*qs.rz;
+ if(Math.abs(off)>tr.halfW-1.6)inp.st-=Math.sign(off)*.5;
+ v.aiCd=(v.aiCd||0)-dt;
+ if(RACE.cfg.items&&v.aiCd<=0&&v.slots.some(Boolean)&&v.stunT<=0){raceAIUse(v);v.aiCd=rnd(1.5,3.5)}
+ return inp;
+}
+function raceAIUse(v){
+ // eldeki itemi mantikli kullan
+ const i=v.slots.findIndex(Boolean);if(i<0)return;
+ const it=v.slots[i].id;
+ if(it==='repair'&&v.hp>v.maxhp*.7)return;
+ if(it==='boost'&&Math.abs(v.steer)>.5)return;
+ if((it==='mine'||it==='orb'||it==='homing'||it==='beam')){
+  let near=null,nd=45;
+  for(const o of RACE.list){if(o===v)continue;
+   const d=Math.hypot(o.x-v.x,o.z-v.z);
+   if(d<nd){const fx=Math.sin(v.yaw),fz=Math.cos(v.yaw);
+    if((o.x-v.x)*fx+(o.z-v.z)*fz>d*.2){near=o;nd=d}}}
+  if(!near&&it!=='mine'&&Math.random()<.6)return;
+ }
+ raceUse(v,1);
+}
